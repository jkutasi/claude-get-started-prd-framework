.claude/*
!.claude/skills/
!.claude/agents/
!.claude/settings.json

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv/
.venv/

# Node
node_modules/
.next/
dist/
build/

# Logs
*.log

